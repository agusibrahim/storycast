{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storycast-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/m/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://storycast-web.aguzz.workers.dev, http://localhost:5173"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "storycast", "database_id": "bbe7c930-47e5-4d3a-a174-5b57d19a89f6" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "storycast-media" }],
  "kv_namespaces": [{ "binding": "GEMINI_ACCOUNTS_KV", "id": "2920392fc33441069fb1bee11c34cc46" }],
  "ratelimits": [{ "name": "VOICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
